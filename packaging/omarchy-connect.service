[Unit]
Description=omarchy-connect: remote access to tmux and agent sessions
Documentation=https://github.com/vanvonlj/omarchy-plugin-connect

# Deliberately not ordered After=tailscaled.service: this is a *user* unit, and
# user units cannot order against system units. The daemon instead exits with a
# clear precondition error when tailscaled is not up yet, and Restart below
# turns that into a retry. Boot ordering is therefore handled by the restart
# loop rather than by a dependency that systemd would silently ignore.

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-connect serve
Restart=on-failure
RestartSec=5s

# The unit runs as the user, without root, because the Tailscale operator grant
# is per-user: that is what makes WhoIs and GetCertificate reachable over the
# LocalAPI socket. Running this as root would need a different grant and would
# hand a shell-adjacent service privileges it has no use for.
NoNewPrivileges=true
ProtectSystem=strict

# tmux keeps its server socket under /tmp/tmux-$UID, and ProtectSystem=strict
# mounts everything except /dev, /proc and /sys read-only. Connecting to a
# socket that already exists still works on a read-only mount, so the daemon can
# list and attach to sessions someone else started -- but it cannot start one:
# `tmux new-session` fails to create its socket and *exits 0 anyway*, so the
# daemon reports success and nothing appears. Sessions created from the phone
# vanish silently. /tmp must be writable.
ReadWritePaths=/tmp

# PrivateTmp is deliberately NOT set, and this is load-bearing rather than an
# oversight. tmux's server socket lives at /tmp/tmux-$UID/default, so a private
# /tmp hides every session on the machine: the daemon starts cleanly, serves the
# UI, answers /api/sessions with an empty list, and refuses every attach with
# "no tmux session named ...". It looks exactly like a machine with no sessions
# open. Anything that reintroduces it has to bind-mount that socket back in.

# Creates ~/.config/omarchy/connect (0700) and makes it writable under
# ProtectSystem=strict. This replaces a ReadWritePaths= for the same directory,
# which fails the whole unit with 226/NAMESPACE on a first run, before anything
# has created it -- exactly the run where a new user finds out.
ConfigurationDirectory=omarchy/connect
ConfigurationDirectoryMode=0700

# ProtectHome is deliberately absent rather than set. The daemon's whole job is
# reaching into $HOME -- tmux sockets, agent state, the config -- so there is no
# useful setting here. (`read-write` is not a valid value; systemd parses it as
# an error, warns, and carries on with no protection at all, which looks like
# hardening in the file while providing none.)

[Install]
WantedBy=default.target
