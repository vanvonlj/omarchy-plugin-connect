# Fixture for LJV-003 (see LJV-001's fixture for the comment format). The
# finding lands on the Secret's own `kind:` line, never on its neighbours'.
apiVersion: secrets.infisical.com/v1beta1
# ok: LJV-003
kind: InfisicalStaticSecret
spec:
  targets:
    - kind: Secret
---
apiVersion: v1
# ruleid: LJV-003
kind: Secret
metadata:
  name: app
stringData:
  password: CHANGEME
---
apiVersion: apps/v1
# ok: LJV-003
kind: Deployment
metadata:
  name: app
---
apiVersion: v1
# ruleid: LJV-003
kind: "Secret"  # quoted, with a comment
metadata:
  name: other
