# Fixture for LJV-005 (see LJV-001's fixture for the comment format). This is the
# rule half only: the canary scans one directory, so "some other manifest creates
# the Secret" (scan.py's drop_created_secrets) is checked in test_sast_rules.py.
# The shape of gitops apps/listmonk/backup.yaml (sdc-backup), names changed.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-dump
spec:
  schedule: "17 3 * * *"
  jobTemplate:
    spec:
      template:
        spec:
          volumes:
            - name: certs
              secret:
                # ruleid: LJV-005
                secretName: dump-ca
          containers:
            - name: upload
              envFrom:
                # ruleid: LJV-005
                - secretRef:
                    name: dump-env
              env:
                - name: S3_ACCESS_KEY
                  # ruleid: LJV-005
                  valueFrom: { secretKeyRef: { name: dump-s3, key: S3_ACCESS_KEY } }
                - name: S3_SECRET_KEY
                  valueFrom:
                    # ruleid: LJV-005
                    secretKeyRef:
                      key: S3_SECRET_KEY
                      name: dump-s3
                - name: MAYBE
                  # ok: LJV-005
                  valueFrom: { secretKeyRef: { name: dump-s3, key: MAYBE, optional: true } }
---
# Suspended until the human step is done: clean.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: nightly-dump-suspended
spec:
  suspend: true
  schedule: "17 3 * * *"
  jobTemplate:
    spec:
      template:
        spec:
          containers:
            - name: upload
              env:
                - name: S3_ACCESS_KEY
                  # ok: LJV-005
                  valueFrom: { secretKeyRef: { name: dump-s3, key: S3_ACCESS_KEY } }
---
# A Job is checked the same way; a Deployment is not (it has no suspend).
apiVersion: batch/v1
kind: Job
metadata:
  name: one-shot
spec:
  template:
    spec:
      containers:
        - name: c
          envFrom:
            # ruleid: LJV-005
            - secretRef:
                name: one-shot-env
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app
spec:
  template:
    spec:
      containers:
        - name: c
          envFrom:
            # ok: LJV-005
            - secretRef:
                name: app-env
