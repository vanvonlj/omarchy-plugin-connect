# Fixture for LJV-008 (see LJV-001's fixture for the comment format).
# The finding is on the `run:` key, so the marker goes right above it.
# gitops#351 red-team pass 1: python3 in the PR checkout, a secret later in the job.
on:
  pull_request:
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Check yaml is importable
        # ruleid: LJV-008
        run: python3 -c 'import yaml'
      - name: Apply
        env:
          ARGOCD_TOKEN: ${{ secrets.ARGOCD_TOKEN }}
        # ok: LJV-008
        run: argocd app sync app
      - env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        # ruleid: LJV-008
        run: npm ci
      # a script in a block, behind other commands
      - name: Block
        # ruleid: LJV-008
        run: |
          set -euo pipefail
          cd tools && python3 gen.py
      - name: In a condition
        # ruleid: LJV-008
        run: |
          if python -c 'import json'; then echo ok; fi
      - name: Env prefix and sudo
        # ruleid: LJV-008
        run: FOO=1 sudo -E pip3 install -r requirements.txt
      - name: Node
        # ruleid: LJV-008
        run: node build.js
      - name: Python flags that are not isolation
        # ruleid: LJV-008
        run: python3 -B -u script.py
      - name: Versioned python
        # ruleid: LJV-008
        run: python3.12 -m pytest
      - name: Relative working-directory is still the checkout
        working-directory: sub
        # ruleid: LJV-008
        run: npx tsc
      - name: Isolated
        # ok: LJV-008
        run: python3 -I -S "$RD/x.py"
      - name: Isolated, other flags first
        # ok: LJV-008
        run: python3 -B -I -c 'import yaml'
      # claude-review.yml: review.py taken from the base ref into /tmp
      - name: Script outside the checkout
        # ok: LJV-008
        run: python3 /tmp/review.py
      - name: Script outside the checkout, with a flag
        # ok: LJV-008
        run: python3 -u /tmp/review.py
      - name: No package scripts
        # ok: LJV-008
        run: npm ci --ignore-scripts
      # claude-review.yml: a global install of a registry package
      - name: Global install
        # ok: LJV-008
        run: npm install -g @anthropic-ai/claude-code
      - name: Local install is the checkout's
        # ruleid: LJV-008
        run: npm install typescript
      - name: Mentioned, not run
        # ok: LJV-008
        run: |
          # python3 is mentioned here, not run
          echo "python3 is required"
          python3 --version
      - name: Working directory outside the checkout
        working-directory: /tmp/work
        # ok: LJV-008
        run: python3 -c 'import yaml'
      - name: Working directory on runner.temp
        working-directory: ${{ runner.temp }}/x
        # ok: LJV-008
        run: npm ci
      - name: Words only
        # ok: LJV-008
        run: echo node and npm and pip
      - name: A helper script, not an interpreter
        # ok: LJV-008
        run: ./python3-helper.sh
      - name: Not a run step
        uses: actions/setup-node@v4
        with:
          node-version: 22
---
# Secret in the job env, interpreter in a step with none of its own.
jobs:
  build:
    runs-on: ubuntu-latest
    env:
      TOKEN: ${{ secrets.DEPLOY_TOKEN }}
    steps:
      - name: Install
        # ruleid: LJV-008
        run: npm install some-tool
---
# No secrets in the job: nothing to steal. `vars.*` is not a secret.
jobs:
  lint:
    runs-on: ubuntu-latest
    env:
      URL: ${{ vars.SOME_URL }}
    steps:
      # secrets.X is only mentioned in this comment
      - name: Python
        # ok: LJV-008
        run: python3 -c 'import yaml'
      - name: Npm
        # ok: LJV-008
        run: npm ci
---
# Secrets belong to one job; the other job is not tainted by them.
jobs:
  holds:
    runs-on: ubuntu-latest
    steps:
      - env:
          T: ${{ secrets.X }}
        # ruleid: LJV-008
        run: python3 a.py
  clean:
    runs-on: ubuntu-latest
    steps:
      - name: Other job
        # ok: LJV-008
        run: python3 b.py
---
# CNVYR-474: a workflow-level `env:` secret reaches every job, so every
# interpreter step in the file runs with it.
on:
  pull_request:
env:
  TOKEN: ${{ secrets.DEPLOY_TOKEN }}
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install
        # ruleid: LJV-008
        run: npm install some-tool
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Python in a second job
        # ruleid: LJV-008
        run: python3 -c 'import yaml'
      - name: Isolated
        # ok: LJV-008
        run: python3 -I -c 'import yaml'
      - name: Script outside the checkout
        # ok: LJV-008
        run: python3 /tmp/review.py
      - name: Working directory outside the checkout
        working-directory: /tmp/work
        # ok: LJV-008
        run: npm ci
      - name: No interpreter
        # ok: LJV-008
        run: ./deploy.sh
---
# Same, with `jobs:` written above `env:` (the pattern is key-order sensitive).
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install
        # ruleid: LJV-008
        run: node build.js
env:
  TOKEN: ${{ secrets.DEPLOY_TOKEN }}
---
# Nothing but `env:` and `jobs:`, and a secret inside a longer value.
env:
  URL: https://x/${{ secrets.PATH_TOKEN }}
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install
        # ruleid: LJV-008
        run: pip install thing
---
# A workflow-level env with no secret: nothing to steal.
env:
  URL: ${{ vars.SOME_URL }}
  MODE: release
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - name: Python
        # ok: LJV-008
        run: python3 -c 'import yaml'
      - name: Npm
        # ok: LJV-008
        run: npm ci
---
# A job-level `env:` secret does not reach a sibling job, and is not read as a
# workflow-level one.
jobs:
  holds:
    runs-on: ubuntu-latest
    env:
      T: ${{ secrets.X }}
    steps:
      - name: Python
        # ruleid: LJV-008
        run: python3 a.py
  clean:
    runs-on: ubuntu-latest
    steps:
      - name: Other job
        # ok: LJV-008
        run: python3 b.py
---
# `secrets: inherit` (CNVYR-474): the calling job has no steps, so there is no
# `run:` in it to flag, and the interpreter runs in the called workflow. A
# called workflow in this repo is scanned as its own file: the next document
# is that file, and a secret reaches its jobs only as `${{ secrets.X }}`. One in
# another repo is not visible to a single-file rule (see the header).
on:
  pull_request:
jobs:
  call-local:
    uses: ./.forgejo/workflows/build.yml
    secrets: inherit
  call-remote:
    uses: lukejv-dev/ci/.forgejo/workflows/build.yml@v1
    secrets:
      TOKEN: ${{ secrets.DEPLOY_TOKEN }}
  after:
    needs: [call-local, call-remote]
    runs-on: ubuntu-latest
    steps:
      - name: A job with no secret of its own
        # ok: LJV-008
        run: python3 report.py
---
# The called workflow (`secrets: inherit` above hands it the caller's secrets).
on:
  workflow_call:
    secrets:
      TOKEN:
        required: true
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Install
        env:
          TOKEN: ${{ secrets.TOKEN }}
        # ruleid: LJV-008
        run: npm ci
