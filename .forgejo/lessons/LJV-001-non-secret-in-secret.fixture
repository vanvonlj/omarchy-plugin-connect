# Fixture for LJV-001, run by scan.py's canary on every scan. YAML, but not
# named .yaml so no scanner reads it in place. A `ruleid:` comment marks the
# next line as a hit that must be reported, an `ok:` comment one that must not.
# HLP-429's Authentik blueprint, the case that taught this lesson:
apiVersion: v1
kind: Secret
metadata:
  name: authentik-blueprint
type: Opaque
stringData:
  # ruleid: LJV-001
  users.yaml: |
    version: 1
    entries: []
  # ruleid: LJV-001
  IDRAC_HOST: idrac.lan
  # ok: LJV-001
  DB_PW: CHANGEME
  # ok: LJV-001
  password: CHANGEME
  # ok: LJV-001
  identityId: CHANGEME
---
apiVersion: v1
kind: Secret
metadata:
  name: base64
data:
  # ruleid: LJV-001
  region: dXMtZWFzdA==
  # ok: LJV-001
  token: Q0hBTkdFTUU=
---
# ArgoCD only reads a repository from a Secret.
apiVersion: v1
kind: Secret
metadata:
  name: repo
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  # ok: LJV-001
  type: git
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: config
data:
  # ok: LJV-001
  region: us-east
---
# A real InfisicalStaticSecret target: synced at runtime, nothing in git.
apiVersion: secrets.infisical.com/v1beta1
kind: InfisicalStaticSecret
metadata:
  name: app
spec:
  targets:
    - name: app
      kind: Secret
      template:
        data:
          # ok: LJV-001
          config.yaml: |
            mode: prod
